{
  "$schema": "https://app.kilo.ai/config.json",

  // Every session starts in quick, the cheap solo lane, unless --agent says
  // otherwise; Tab in the TUI cycles to the other primaries (boss, argon,
  // Kilo's built-ins). The value must name a visible primary agent: a
  // missing one throws `default agent "<name>" not found` at session start
  // instead of falling back (agent.ts defaultInfo, kilo 7.8.x). Only an
  // unset key falls back to the built-in "code".
  "default_agent": "quick",

  // Cheap default. Each agent pins its own model in its frontmatter
  // (~/.config/kilo/agents/*.md): quick and the gemini-coder subagent on
  // google/gemini-3.8-flash, boss on anthropic/claude-opus-5-5, argon on
  // google/gemini-4-argon.
  "model": "google/gemini-3.8-flash",
  "small_model": "google/gemini-3.8-flash",
  "instructions": ["~/.config/kilo/instructions.md"],

  // Enables the `websearch` tool. NOT provider-native, and not billed to the
  // keys below: it routes to Parallel through kilo's built-in mcp-parallel
  // transport (tool metadata: provider=parallel, transport=mcp-parallel; the
  // sku_search count in results is Parallel's usage unit). Verified working
  // with no Kilo account (auth.json empty, `kilo profile` reports
  // unauthenticated) and no search API key of ours.
  "web_search": true,

  // Own API keys only - no Kilo gateway/account. Keys live in user-scope
  // env vars, never in this file.
  "provider": {
    "google": { "env": ["GOOGLE_GENERATIVE_AI_API_KEY"] },
    // Live for @boss (anthropic/claude-opus-5-5).
    //
    // baseURL is pinned because kilo 7.4.23 builds the anthropic URL without
    // /v1: requests go to api.anthropic.com/messages, which does not exist,
    // so every model on this provider dies with a bare 404 "Not Found"
    // (kilo.db's AI_APICallError records carry the bad URL; the identical
    // request replayed at /v1/messages returns 200). The SDK appends
    // /messages to this value. Google is unaffected. Not re-verified on the
    // later pins (7.5.16 -> 7.8.18) - harmless on versions that build the
    // URL correctly.
    "anthropic": {
      "options": {
        "baseURL": "https://api.anthropic.com/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
    // The openai and amazon-bedrock providers were removed on 2026-11-04,
    // once no agent used them; git history (21c10d7) keeps their blocks.
  },
  "enabled_providers": ["google", "anthropic"],

  "formatter": true,
  "lsp": true,

  // Skills: ~/.kilo/skills mirrors skills/ in this repo (the installers
  // copy it; pins and licenses in skills/vendor.psd1). Interview skills
  // are gated in permission.skill below.

  // Pin the built-in subagents and title/summary/compaction jobs to the
  // cheap model. Compaction fires routinely at the 40% threshold below, so
  // it should be fast and cheap; plan files and commits carry the durable
  // state.
  "agent": {
    "explore": { "model": "google/gemini-3.8-flash" },
    "general": { "model": "google/gemini-3.8-flash" },
    "title": { "model": "google/gemini-3.8-flash" },
    "summary": { "model": "google/gemini-3.8-flash" },
    "compaction": { "model": "google/gemini-3.8-flash" },
    // Kilo's deprecated built-in orchestrator: it hijacked a run once with
    // generic delegation. Keep it off.
    "orchestrator": { "disable": true }
  },

  // Web search/scrape via Firecrawl MCP; key from user-scope env var.
  // Local stdio keeps the key out of URLs, logs, and `kilo mcp list`.
  // Browser automation via Playwright MCP (headed Google Chrome).
  // install.ps1 / install.sh install both servers globally at pinned
  // versions, so they launch by name instead of `npx -y` downloading them
  // as a session starts. Change a server here and its pin there together.
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["firecrawl-mcp"],
      "environment": { "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}" },
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp", "--browser", "chrome"],
      "enabled": true,
      "timeout": 60000
    }
  },

  // Context economy: trim old tool outputs, auto-compact long sessions.
  "compaction": { "auto": true, "prune": true, "threshold_percent": 40 },

  // Codebase indexing -> the `semantic_search` tool: persistent, per-project
  // repo understanding every agent shares, instead of each subagent
  // re-deriving "where is X" at full price. Gemini embeddings (same
  // GOOGLE_GENERATIVE_AI_API_KEY, via {env:} substitution - the mechanism
  // is proven by the anthropic and firecrawl blocks in this file; only
  // snippets are sent, never whole files) into LanceDB, which is embedded
  // and file-based - no server. Docs:
  // https://kilo.ai/docs/customize/context/codebase-indexing
  // Shipped DISABLED: the block is fully configured but has never been
  // live-run from this machine (added 2026-09-15 without an install pass).
  // To turn it on: flip "enabled" to true (indexes every workspace), or
  // leave it false and enable per project via /indexing in the TUI; then
  // watch /indexing reach Complete and check `semantic_search` appears in
  // the tool roster. Note: the published $schema lags the CLI and may mark
  // this key unknown in editors; the CLI itself reads it (its /indexing
  // menu edits this very block).
  "indexing": {
    "enabled": false,
    "provider": "gemini",
    "model": "gemini-embedding-001",
    "vectorStore": "lancedb",
    "gemini": { "apiKey": "{env:GOOGLE_GENERATIVE_AI_API_KEY}" },
    "lancedb": {}
  },

  // Policy: allow or deny only - never ask, so no session stalls on an
  // approval prompt. Last matching rule wins.
  "permission": {
    "*": "allow",
    "task": { "*": "allow" },
    "doom_loop": "deny",

    // Interview skills ask the user and wait on decisions, so only the
    // attended primaries (quick, boss, argon) re-allow them in their own
    // frontmatter. Kilo ignores the upstream disable-model-invocation flag
    // (absent from the 7.8.18 binary); a denied skill is withheld from
    // <available_skills>, so permission is the only gate.
    "skill": { "*": "allow", "grilling": "deny", "grill-with-docs": "deny" },

    // Firecrawl registers ~25 tools; denied ones are withheld from the
    // model, saving their schema tokens on every request.
    "firecrawl_firecrawl_*": "deny",
    "firecrawl_firecrawl_search": "allow",
    "firecrawl_firecrawl_scrape": "allow",
    "firecrawl_firecrawl_map": "allow",

    "read": {
      "*": "allow",
      "**/.ssh/**": "deny", "**/.aws/**": "deny", "**/.gnupg/**": "deny",
      "**/id_rsa*": "deny", "*.pem": "deny",
      "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow"
    },

    "edit": {
      "*": "allow",
      ".git/**": "deny", "**/node_modules/**": "deny", "**/.venv/**": "deny",
      "*.env": "deny", "*.env.*": "deny",
      "kilo.json": "deny", "kilo.jsonc": "deny", ".kilo/**": "deny",
      "~/.kilo/**": "deny", "~/.config/kilo/**": "deny"
    },

    "write": {
      "*": "allow",
      ".git/**": "deny", "*.env": "deny", "*.env.*": "deny",
      "kilo.json": "deny", "kilo.jsonc": "deny", ".kilo/**": "deny",
      "~/.kilo/**": "deny", "~/.config/kilo/**": "deny"
    },

    "bash": {
      "*": "allow",

      "Remove-Item*": "deny", "Clear-Content*": "deny", "Clear-Item*": "deny",
      "ri *": "deny", "rm *": "deny", "rd *": "deny", "rmdir*": "deny",
      "del *": "deny", "erase*": "deny",

      "git push --force*": "deny", "git push -f*": "deny",
      "git reset --hard*": "deny", "git clean*": "deny",
      "git filter-branch*": "deny", "git config --global*": "deny",

      "Invoke-Expression*": "deny", "iex*": "deny", "Invoke-Command*": "deny",
      "Invoke-Item*": "deny", "Start-Process*": "deny", "Add-Type*": "deny",
      "powershell*": "deny", "pwsh*": "deny", "cmd*": "deny",
      "Set-ExecutionPolicy*": "deny",

      "Invoke-WebRequest*": "deny", "Invoke-RestMethod*": "deny",
      "iwr*": "deny", "irm*": "deny", "curl*": "deny", "wget*": "deny",
      "ssh*": "deny", "scp*": "deny",

      "npm publish*": "deny", "npm login*": "deny", "gh auth*": "deny",
      "gh secret*": "deny", "gh repo delete*": "deny", "gh release*": "deny",
      "cargo publish*": "deny", "twine*": "deny", "gem push*": "deny",
      "dotnet nuget push*": "deny", "mvn deploy*": "deny",
      "Get-Credential*": "deny", "aws*": "deny", "az*": "deny", "gcloud*": "deny",

      "Stop-Process*": "deny", "taskkill*": "deny", "Stop-Service*": "deny",
      "Start-Service*": "deny", "Set-Service*": "deny", "New-Service*": "deny",
      "sc.exe*": "deny", "Restart-Computer*": "deny", "Stop-Computer*": "deny",
      "shutdown*": "deny", "Set-ItemProperty*": "deny",
      "New-ItemProperty*": "deny", "Remove-ItemProperty*": "deny",
      "reg *": "deny", "reg.exe*": "deny", "Set-Acl*": "deny",
      "icacls*": "deny", "takeown*": "deny", "net user*": "deny",
      "net localgroup*": "deny", "schtasks*": "deny",
      "Register-ScheduledTask*": "deny", "Set-MpPreference*": "deny",
      "Add-MpPreference*": "deny", "netsh*": "deny", "wmic*": "deny",
      "diskpart*": "deny", "fsutil*": "deny", "vssadmin*": "deny",
      "format*": "deny", "bcdedit*": "deny",

      // Local HTTP is a normal dev loop (smoke-testing servers); these
      // narrower rules come after the network denies so they win.
      "curl *localhost*": "allow", "curl *127.0.0.1*": "allow",
      "wget *localhost*": "allow", "wget *127.0.0.1*": "allow",
      "Invoke-WebRequest *localhost*": "allow", "Invoke-WebRequest *127.0.0.1*": "allow",
      "Invoke-RestMethod *localhost*": "allow", "Invoke-RestMethod *127.0.0.1*": "allow",
      "iwr *localhost*": "allow", "irm *localhost*": "allow",
      "iwr *127.0.0.1*": "allow", "irm *127.0.0.1*": "allow"
    },

    // Deny-all clobbers Kilo's injected per-skill allows (config loads after
    // built-in defaults), so skill/tmp paths must be re-allowed explicitly.
    "external_directory": {
      "*": "deny",
      "~/.kilo/skills/**": "allow",
      "~/AppData/Local/Temp/kilo/**": "allow"
    }
  }
}
